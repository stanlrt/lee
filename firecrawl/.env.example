# Firecrawl API runtime defaults for in-repo self-hosting.
# Copy to firecrawl/.env and override as needed.

HOST=0.0.0.0
PORT=3002
USE_DB_AUTHENTICATION=false

# Optional API auth for clients (including NanoClaw firecrawl-mcp).
# Leave empty if auth is disabled.
# FIRECRAWL_API_KEY=

# Optional: override image if your registry/tag differs.
# FIRECRAWL_IMAGE=ghcr.io/firecrawl/firecrawl:latest
